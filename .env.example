# CCP Confidential Communication Portal — Environment Configuration
# Copy this file to .env and configure for your deployment

# Database Configuration (Supabase / Neon / PostgreSQL)
# DATABASE_URL: Transaction pooler URL (e.g., Supabase port 6543 with pgbouncer=true)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Direct database connection URL for migrations (e.g., Supabase port 5432)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Optional Supabase Client Keys (if using client SDK)
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="[your-anon-or-publishable-key]"

# Security & Session Settings
SESSION_SECRET="generate-a-secure-random-string-at-least-32-chars-long"
APP_URL="https://your-deployment-domain.com"
NODE_ENV="production"

# Demo Account Password (default: DemoPassword123!)
DEMO_PASSWORD="DemoPassword123!"
